{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "strict": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "public/build",
    "lib": ["ES2022", "DOM"],
    "types": ["phaser"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
